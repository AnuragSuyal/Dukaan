generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ShopStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum RouteStatus {
  ACTIVE
  PAUSED
}

enum OrderSource {
  HISTORICAL
  RETAILER
  SALESMAN
  DEMAND_SIGNAL
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  LOADED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CREDIT
  BANK_TRANSFER
  MIXED
}

enum SignalStatus {
  DRAFT
  SENT
  CONFIRMED
  MODIFIED
  REJECTED
  EXPIRED
  NO_RESPONSE
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum StaffRole {
  SALESMAN
  DRIVER
  WAREHOUSE
  MANAGER
}

enum DispatchStatus {
  DRAFT
  LOADING
  FINALIZED
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum DeliveryStopStatus {
  PENDING
  ARRIVED
  DELIVERED
  PARTIAL
  FAILED
  SKIPPED
}

enum ReconciliationStatus {
  DRAFT
  FINALIZED
}

model Distributor {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]
  shops         Shop[]
  routes        Route[]
  orders        Order[]
  demandSignals DemandSignal[]
  vehicles      Vehicle[]
  staff         Staff[]
  dispatches    Dispatch[]
}

model Product {
  id              String   @id @default(cuid())
  distributorId   String
  sku             String
  name            String
  brand           String?
  category        String?
  packSize        String?
  unit            String
  unitPricePaise  Int
  unitWeightGrams Int      @default(0)
  unitLoadPoints  Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  distributor         Distributor                  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  orderItems          OrderItem[]
  demandSignalItems   DemandSignalItem[]
  dispatchItems       DispatchItem[]
  deliveryStopItems   DeliveryStopItem[]
  reconciliationItems DispatchReconciliationItem[]

  @@unique([distributorId, sku])
  @@index([distributorId, isActive])
  @@index([name])
}

model Route {
  id            String      @id @default(cuid())
  distributorId String
  code          String
  name          String
  deliveryDays  String?
  status        RouteStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  distributor   Distributor    @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  shops         Shop[]
  orders        Order[]
  demandSignals DemandSignal[]
  dispatches    Dispatch[]

  @@unique([distributorId, code])
  @@index([distributorId, status])
}

model Shop {
  id               String     @id @default(cuid())
  distributorId    String
  routeId          String?
  name             String
  ownerName        String?
  phone            String
  address          String?
  locality         String?
  latitude         Float?
  longitude        Float?
  preferredWindow  String?
  creditLimitPaise Int        @default(0)
  outstandingPaise Int        @default(0)
  status           ShopStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  distributor   Distributor    @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  route         Route?         @relation(fields: [routeId], references: [id], onDelete: SetNull)
  orders        Order[]
  demandSignals DemandSignal[]
  deliveryStops DeliveryStop[]

  @@unique([distributorId, phone])
  @@index([distributorId, status])
  @@index([routeId])
}

model Order {
  id            String         @id @default(cuid())
  distributorId String
  shopId        String
  routeId       String?
  invoiceNumber String?
  source        OrderSource    @default(HISTORICAL)
  status        OrderStatus    @default(DRAFT)
  orderDate     DateTime
  deliveryDate  DateTime?
  confirmedAt   DateTime?
  dispatchedAt  DateTime?
  deliveredAt   DateTime?
  totalPaise    Int            @default(0)
  paymentMethod PaymentMethod?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  route       Route?      @relation(fields: [routeId], references: [id], onDelete: SetNull)
  items       OrderItem[]

  @@index([distributorId, orderDate])
  @@index([shopId, orderDate])
  @@index([routeId, deliveryDate])
  @@index([status])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPricePaise Int
  lineTotalPaise Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
}

model DemandSignal {
  id                  String       @id @default(cuid())
  distributorId       String
  shopId              String
  routeId             String?
  targetDate          DateTime
  status              SignalStatus @default(DRAFT)
  averageConfidence   Int
  totalSuggestedPaise Int          @default(0)
  confirmationToken   String       @unique @default(cuid())
  sentAt              DateTime?
  confirmedAt         DateTime?
  expiresAt           DateTime?
  merchantNote        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  distributor   Distributor        @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  route         Route?             @relation(fields: [routeId], references: [id], onDelete: SetNull)
  items         DemandSignalItem[]
  deliveryStops DeliveryStop[]

  @@index([distributorId, targetDate])
  @@index([shopId, targetDate])
  @@index([routeId, targetDate])
  @@index([status])
}

model DemandSignalItem {
  id                  String @id @default(cuid())
  demandSignalId      String
  productId           String
  suggestedQuantity   Int
  confirmedQuantity   Int?
  confidence          Int
  reason              String
  unitPricePaise      Int
  suggestedTotalPaise Int

  demandSignal      DemandSignal       @relation(fields: [demandSignalId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  deliveryStopItems DeliveryStopItem[]

  @@unique([demandSignalId, productId])
  @@index([productId])
}

model Vehicle {
  id                 String        @id @default(cuid())
  distributorId      String
  code               String
  name               String
  registrationNumber String?
  maxWeightGrams     Int
  maxLoadPoints      Int
  status             VehicleStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  dispatches  Dispatch[]

  @@unique([distributorId, code])
  @@index([distributorId, status])
}

model Staff {
  id            String    @id @default(cuid())
  distributorId String
  employeeCode  String
  name          String
  phone         String?
  role          StaffRole
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  distributor        Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  driverDispatches   Dispatch[]  @relation("DispatchDriver")
  salesmanDispatches Dispatch[]  @relation("DispatchSalesman")

  @@unique([distributorId, employeeCode])
  @@index([distributorId, role, isActive])
}

model Dispatch {
  id                  String         @id @default(cuid())
  distributorId       String
  routeId             String
  vehicleId           String?
  driverId            String?
  salesmanId          String?
  targetDate          DateTime
  status              DispatchStatus @default(DRAFT)
  confirmedValuePaise Int            @default(0)
  plannedWeightGrams  Int            @default(0)
  plannedLoadPoints   Int            @default(0)
  finalizedAt         DateTime?
  dispatchedAt        DateTime?
  completedAt         DateTime?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  distributor    Distributor             @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  route          Route                   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver         Staff?                  @relation("DispatchDriver", fields: [driverId], references: [id], onDelete: SetNull)
  salesman       Staff?                  @relation("DispatchSalesman", fields: [salesmanId], references: [id], onDelete: SetNull)
  items          DispatchItem[]
  stops          DeliveryStop[]
  reconciliation DispatchReconciliation?

  @@unique([routeId, targetDate])
  @@index([distributorId, targetDate])
  @@index([vehicleId, targetDate])
  @@index([status])
}

model DispatchItem {
  id                  String @id @default(cuid())
  dispatchId          String
  productId           String
  confirmedQuantity   Int
  reserveQuantity     Int
  plannedQuantity     Int
  unitWeightGrams     Int
  unitLoadPoints      Int
  plannedWeightGrams  Int
  plannedLoadPoints   Int
  confirmedValuePaise Int

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, productId])
  @@index([productId])
}

model DeliveryStop {
  id                         String             @id @default(cuid())
  dispatchId                 String
  demandSignalId             String
  shopId                     String
  sequence                   Int
  status                     DeliveryStopStatus @default(PENDING)
  expectedValuePaise         Int                @default(0)
  arrivedAt                  DateTime?
  completedAt                DateTime?
  paymentMethod              PaymentMethod?
  currentOrderCollectedPaise Int                @default(0)
  outstandingCollectedPaise  Int                @default(0)
  creditExtendedPaise        Int                @default(0)
  returnedCrates             Int                @default(0)
  damagedItemsCollected      Int                @default(0)
  shopkeeperName             String?
  confirmationCode           String
  driverNote                 String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  dispatch     Dispatch           @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  demandSignal DemandSignal       @relation(fields: [demandSignalId], references: [id], onDelete: Cascade)
  shop         Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items        DeliveryStopItem[]

  @@unique([dispatchId, demandSignalId])
  @@index([dispatchId, sequence])
  @@index([shopId])
  @@index([status])
}

model DeliveryStopItem {
  id                 String @id @default(cuid())
  deliveryStopId     String
  demandSignalItemId String
  productId          String
  orderedQuantity    Int
  deliveredQuantity  Int    @default(0)
  missingQuantity    Int    @default(0)
  damagedQuantity    Int    @default(0)
  returnedQuantity   Int    @default(0)
  unitPricePaise     Int

  deliveryStop     DeliveryStop     @relation(fields: [deliveryStopId], references: [id], onDelete: Cascade)
  demandSignalItem DemandSignalItem @relation(fields: [demandSignalItemId], references: [id], onDelete: Restrict)
  product          Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([deliveryStopId, demandSignalItemId])
  @@index([productId])
}

model DispatchReconciliation {
  id                             String               @id @default(cuid())
  dispatchId                     String               @unique
  status                         ReconciliationStatus @default(DRAFT)
  expectedCashPaise              Int                  @default(0)
  declaredCashPaise              Int                  @default(0)
  cashVariancePaise              Int                  @default(0)
  expectedUpiPaise               Int                  @default(0)
  verifiedUpiPaise               Int                  @default(0)
  upiVariancePaise               Int                  @default(0)
  expectedBankPaise              Int                  @default(0)
  verifiedBankPaise              Int                  @default(0)
  bankVariancePaise              Int                  @default(0)
  expectedMixedPaise             Int                  @default(0)
  declaredMixedPaise             Int                  @default(0)
  mixedVariancePaise             Int                  @default(0)
  totalDeliveredValuePaise       Int                  @default(0)
  totalCreditPaise               Int                  @default(0)
  totalOutstandingCollectedPaise Int                  @default(0)
  totalMissingUnits              Int                  @default(0)
  totalDamagedUnits              Int                  @default(0)
  totalReturnedFromShopsUnits    Int                  @default(0)
  note                           String?
  finalizedAt                    DateTime?
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt

  dispatch Dispatch                     @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  items    DispatchReconciliationItem[]
}

model DispatchReconciliationItem {
  id                        String @id @default(cuid())
  reconciliationId          String
  productId                 String
  loadedQuantity            Int
  deliveredQuantity         Int
  missingQuantity           Int    @default(0)
  damagedQuantity           Int    @default(0)
  returnedFromShopsQuantity Int    @default(0)
  expectedReturnQuantity    Int
  actualReturnQuantity      Int    @default(0)
  varianceQuantity          Int    @default(0)

  reconciliation DispatchReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  product        Product                @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([reconciliationId, productId])
  @@index([productId])
}
